<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_x88_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_title"
            android:textColor="#EAF7FF"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="MASTER AUS"
            android:textColor="#93A5B5"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Lokaler Gerätezugriff ist ausgeschaltet"
        android:textColor="#A8BED0"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_open"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_x88_button_background"
            android:gravity="center"
            android:text="@string/widget_open"
            android:textColor="#EAF7FF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_master_action"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1.4"
            android:background="@drawable/widget_x88_button_background"
            android:gravity="center"
            android:maxLines="1"
            android:text="IN APP AKTIVIEREN"
            android:textColor="#25D9FF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_stop_all"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_x88_stop_background"
            android:gravity="center"
            android:text="@string/widget_stop_all"
            android:textColor="#FF8CA7"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
